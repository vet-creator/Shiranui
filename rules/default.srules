# ============================================================================
#  SHIRANUI default rule set
#  Format reference: include/shiranui/signature.hpp
#
#  Detection signatures are written to be *explainable*: each rule states what
#  it looks for and why that matters, so an analyst can judge a hit rather than
#  trusting a black box. Rules deliberately favour precision over recall; the
#  heuristic engine covers the fuzzy end.
#
#  NOTE ON ENCODING: literal malware strings are written as hex byte patterns
#  rather than quoted text. That keeps this repository from tripping other
#  vendors' scanners while remaining byte-identical at match time.
# ============================================================================

# ---------------------------------------------------------------------------
# Industry-standard test file. Not malware; used to prove the pipeline works.
# ---------------------------------------------------------------------------
rule EICAR_Test_File : test standard {
    meta:
        severity    = critical
        family      = "EICAR"
        description = "EICAR anti-malware test file (harmless; verifies detection is wired up)"
        reference   = "https://www.eicar.org/download-anti-malware-testfile/"
    strings:
        $eicar = { 58 35 4F 21 50 25 40 41 50 5B 34 5C 50 5A 58 35 34 28 50 5E 29 37 43 43 29 37 7D 24 45 49 43 41 52 2D 53 54 41 4E 44 41 52 44 2D 41 4E 54 49 56 49 52 55 53 2D 54 45 53 54 2D 46 49 4C 45 21 24 48 2B 48 2A }
    condition:
        $eicar
}

hash sha256 = 275a021bbfb6489e54d471899f7db9d1663fc695ec2fe2a2c4538aabf651fd0f name=EICAR.Test.File severity=critical family=EICAR

# ---------------------------------------------------------------------------
# Runtime packers. Packing is not malicious by itself, hence the low severity;
# the heuristic engine escalates when packing coincides with other signals.
# ---------------------------------------------------------------------------
rule Packer_UPX : packer {
    meta:
        severity    = low
        family      = "UPX"
        description = "UPX-packed executable (section names UPX0/UPX1 plus the UPX! marker)"
    strings:
        $s0 = { 55 50 58 30 00 00 00 00 }
        $s1 = { 55 50 58 31 00 00 00 00 }
        $s2 = { 55 50 58 21 }
    condition:
        2 of them
}

rule Packer_Themida_VMProtect : packer obfuscation {
    meta:
        severity    = low
        description = "Commercial virtualisation-based protector detected by section naming"
    strings:
        $themida = { 2E 74 68 65 6D 69 64 61 }
        $winlic  = { 2E 77 69 6E 6C 69 63 65 }
        $vmp0    = { 2E 76 6D 70 30 }
        $vmp1    = { 2E 76 6D 70 31 }
        $enigma  = { 2E 65 6E 69 67 6D 61 31 }
    condition:
        any of them
}

rule Packer_MPRESS_ASPack : packer {
    meta:
        severity    = low
        description = "MPRESS or ASPack compressed executable"
    strings:
        $mpress1 = { 2E 4D 50 52 45 53 53 31 }
        $aspack  = { 2E 61 73 70 61 63 6B }
        $adata   = { 2E 61 64 61 74 61 }
    condition:
        any of them
}

# ---------------------------------------------------------------------------
# Offensive-security tooling. Legitimate for red teams, alarming on an endpoint.
# ---------------------------------------------------------------------------
rule Tool_Mimikatz_Artifacts : credential_access tool {
    meta:
        severity    = critical
        family      = "Mimikatz"
        description = "Credential-dumping toolkit artifacts (banner, module and command strings)"
    strings:
        $a = { 6D 69 6D 69 6B 61 74 7A }
        $b = { 67 65 6E 74 69 6C 6B 69 77 69 }
        $c = { 73 65 6B 75 72 6C 73 61 3A 3A 6C 6F 67 6F 6E 50 61 73 73 77 6F 72 64 73 }
        $d = { 6C 73 61 64 75 6D 70 3A 3A 73 61 6D }
        $e = { 6B 65 72 62 65 72 6F 73 3A 3A 67 6F 6C 64 65 6E }
    condition:
        2 of them
}

rule Tool_ReflectiveLoader : loader tool {
    meta:
        severity    = high
        description = "Reflective DLL loading export, used by post-exploitation frameworks"
    strings:
        $a = { 52 65 66 6C 65 63 74 69 76 65 4C 6F 61 64 65 72 }
        $b = { 5F 52 65 66 6C 65 63 74 69 76 65 4C 6F 61 64 65 72 40 34 }
    condition:
        any of them
}

rule Tool_Beacon_Config : c2 tool {
    meta:
        severity    = critical
        family      = "CobaltStrike"
        description = "Beacon-style implant markers and default named-pipe patterns"
    strings:
        $a = { 62 65 61 63 6F 6E 2E 64 6C 6C }
        $b = { 25 73 28 20 61 64 6D 69 6E 20 29 }
        $c = { 5C 5C 2E 5C 70 69 70 65 5C 4D 53 53 45 2D }
        $d = { 43 6F 62 61 6C 74 20 53 74 72 69 6B 65 }
    condition:
        2 of them
}

# ---------------------------------------------------------------------------
# Living-off-the-land abuse in scripts and droppers.
# ---------------------------------------------------------------------------
rule Script_PowerShell_Encoded_Stealth : script lolbin {
    meta:
        severity    = medium
        family      = "PowerShell"
        description = "PowerShell invoked with an encoded command together with stealth or policy-bypass flags"
    strings:
        # An encoded command, so the actual instructions are not readable here.
        $enc1 = "-EncodedCommand" nocase ascii wide
        $enc2 = " -enc " nocase ascii wide
        $enc3 = " -ec " nocase ascii wide
        $enc4 = "FromBase64String" nocase ascii wide
        # Deliberate concealment of the window or the execution policy.
        $hid1 = "-WindowStyle Hidden" nocase ascii wide
        $hid2 = "-w hidden" nocase ascii wide
        $byp1 = "-ExecutionPolicy Bypass" nocase ascii wide
        $byp2 = "-ep bypass" nocase ascii wide
    condition:
        # Both categories are required. Neither is conclusive alone: automation
        # tools legitimately pass -EncodedCommand, and installers legitimately
        # pass -ExecutionPolicy Bypass. Severity is medium for the same reason --
        # this is corroborating evidence, not a verdict.
        ($enc1 or $enc2 or $enc3 or $enc4) and ($hid1 or $hid2 or $byp1 or $byp2)
}

rule Script_PowerShell_Download_Execute : script lolbin {
    meta:
        severity    = medium
        family      = "PowerShell"
        description = "PowerShell download-and-execute one-liner"
    strings:
        # Retrieval.
        $dl1 = "Net.WebClient).DownloadString" nocase ascii wide
        $dl2 = "Net.WebClient).DownloadFile" nocase ascii wide
        $dl3 = "Invoke-WebRequest" nocase ascii wide
        $dl4 = "DownloadString(" nocase ascii wide
        # Execution of what was retrieved. A bare "IEX" is not usable as an
        # indicator: it is three case-sensitive bytes and matches inside ordinary
        # identifiers such as the POSIX termios constant IEXTEN, which is present
        # in most Go binaries. Only the call and pipe forms are specific.
        $x1 = "IEX(" nocase ascii wide
        $x2 = "IEX (" nocase ascii wide
        $x3 = "| IEX" nocase ascii wide
        $x4 = "Invoke-Expression" nocase ascii wide
    condition:
        # Installation documentation embedded in a legitimate binary contains this
        # exact idiom, so static matching cannot separate the two. Medium severity
        # reflects what the evidence actually supports.
        ($dl1 or $dl2 or $dl3 or $dl4) and ($x1 or $x2 or $x3 or $x4)
}

rule Script_PowerShell_Base64_UTF16 : script encoded {
    meta:
        severity    = high
        family      = "PowerShell"
        description = "Base64 of UTF-16LE PowerShell source - the payload an -EncodedCommand chain carries, matched directly so the command line need not be readable"
    strings:
        $invoke_expr0 = "SQBuAHYAbwBrAGUALQBFAHgAcAByAGUAcwBzAGkAbwBuAA"   # Invoke-Expression
        $invoke_expr1 = "bgB2AG8AawBlAC0ARQB4AHAAcgBlAHMAcwBpAG8AbgA"   # Invoke-Expression
        $invoke_expr2 = "AG4AdgBvAGsAZQAtAEUAeABwAHIAZQBzAHMAaQBvAG4A"   # Invoke-Expression
        $webclient0 = "TgBlAHQALgBXAGUAYgBDAGwAaQBlAG4AdAA"   # Net.WebClient
        $webclient1 = "ZQB0AC4AVwBlAGIAQwBsAGkAZQBuAHQA"   # Net.WebClient
        $webclient2 = "AGUAdAAuAFcAZQBiAEMAbABpAGUAbgB0AA"   # Net.WebClient
        $downloadstring0 = "RABvAHcAbgBsAG8AYQBkAFMAdAByAGkAbgBnAA"   # DownloadString
        $downloadstring1 = "bwB3AG4AbABvAGEAZABTAHQAcgBpAG4AZwA"   # DownloadString
        $downloadstring2 = "AG8AdwBuAGwAbwBhAGQAUwB0AHIAaQBuAGcA"   # DownloadString
        $downloadfile0 = "RABvAHcAbgBsAG8AYQBkAEYAaQBsAGUA"   # DownloadFile
        $downloadfile1 = "bwB3AG4AbABvAGEAZABGAGkAbABlAA"   # DownloadFile
        $downloadfile2 = "AG8AdwBuAGwAbwBhAGQARgBpAGwAZQA"   # DownloadFile
        $powershell0 = "cABvAHcAZQByAHMAaABlAGwAbAA"   # powershell
        $powershell1 = "bwB3AGUAcgBzAGgAZQBsAGwA"   # powershell
        $powershell2 = "AG8AdwBlAHIAcwBoAGUAbABsAA"   # powershell
        $http0 = "aAB0AHQAcAA6AC8ALwA"   # http://
        $http1 = "dAB0AHAAOgAvAC8A"   # http://
        $http2 = "AHQAdABwADoALwAvAA"   # http://
        $startprocess0 = "UwB0AGEAcgB0AC0AUAByAG8AYwBlAHMAcwA"   # Start-Process
        $startprocess1 = "dABhAHIAdAAtAFAAcgBvAGMAZQBzAHMA"   # Start-Process
        $startprocess2 = "AHQAYQByAHQALQBQAHIAbwBjAGUAcwBzAA"   # Start-Process
        $frombase640 = "RgByAG8AbQBCAGEAcwBlADYANABTAHQAcgBpAG4AZwA"   # FromBase64String
        $frombase641 = "cgBvAG0AQgBhAHMAZQA2ADQAUwB0AHIAaQBuAGcA"   # FromBase64String
        $frombase642 = "AHIAbwBtAEIAYQBzAGUANgA0AFMAdAByAGkAbgBnAA"   # FromBase64String
        $reflection0 = "UwB5AHMAdABlAG0ALgBSAGUAZgBsAGUAYwB0AGkAbwBuAA"   # System.Reflection
        $reflection1 = "eQBzAHQAZQBtAC4AUgBlAGYAbABlAGMAdABpAG8AbgA"   # System.Reflection
        $reflection2 = "AHkAcwB0AGUAbQAuAFIAZQBmAGwAZQBjAHQAaQBvAG4A"   # System.Reflection
    condition:
        any of them
}

rule Script_Wscript_Dropper : script dropper {
    meta:
        severity    = medium
        description = "Script host dropper writing and launching a payload"
    strings:
        $a = "WScript.Shell" nocase ascii wide
        $b = "ADODB.Stream" nocase ascii wide
        $c = "Scripting.FileSystemObject" nocase ascii wide
        $d = "MSXML2.XMLHTTP" nocase ascii wide
        $e = "SaveToFile" nocase ascii wide
    condition:
        3 of them
}

rule LOLBin_Abuse_Chain : lolbin {
    meta:
        severity    = medium
        description = "Signed Windows binaries chained in a way typical of proxy execution"
    strings:
        $a = "regsvr32" nocase ascii wide
        $b = "scrobj.dll" nocase ascii wide
        $c = "mshta" nocase ascii wide
        $d = "rundll32" nocase ascii wide
        $e = "certutil -urlcache" nocase ascii wide
        $f = "bitsadmin /transfer" nocase ascii wide
    condition:
        2 of them
}

# ---------------------------------------------------------------------------
# Destructive behaviour: ransomware precursors.
# ---------------------------------------------------------------------------
rule Ransom_ShadowCopy_Destruction : ransomware destructive {
    meta:
        severity    = critical
        family      = "Generic.Ransom"
        description = "Deletes volume shadow copies and disables recovery — pre-encryption stage"
    strings:
        $a = "vssadmin delete shadows" nocase ascii wide
        $b = "wbadmin delete catalog" nocase ascii wide
        $c = "bcdedit /set {default} recoveryenabled no" nocase ascii wide
        $d = "wmic shadowcopy delete" nocase ascii wide
        $e = "bcdedit /set {default} bootstatuspolicy ignoreallfailures" nocase ascii wide
    condition:
        any of them
}

rule Ransom_Note_Markers : ransomware {
    meta:
        severity    = high
        description = "Ransom-note phrasing combined with a payment channel"
    strings:
        $a = "your files have been encrypted" nocase ascii wide
        $b = "all your files are encrypted" nocase ascii wide
        $c = ".onion" nocase ascii wide
        $d = "decryption key" nocase ascii wide
        $e = "bitcoin" nocase ascii wide
    condition:
        ($a or $b) and 2 of them
}

# ---------------------------------------------------------------------------
# Server-side webshells.
# ---------------------------------------------------------------------------
rule Webshell_PHP_Eval : webshell {
    meta:
        severity    = high
        description = "PHP webshell: request data passed straight into an evaluator"
    strings:
        $e1 = "eval(base64_decode(" nocase
        $e2 = "eval($_POST" nocase
        $e3 = "eval($_REQUEST" nocase
        $e4 = "assert($_POST" nocase
        $e5 = "preg_replace(\"/.*/e\"" nocase
        $e6 = "system($_GET" nocase
    condition:
        any of them
}

rule Webshell_ASP_Execute : webshell {
    meta:
        severity    = high
        description = "Classic ASP webshell passing request parameters to Execute/Eval"
    strings:
        $a = "Execute(Request" nocase
        $b = "eval(Request" nocase
        $c = "Server.CreateObject(\"WScript.Shell\")" nocase
        $d = "Response.BinaryWrite" nocase
    condition:
        2 of them
}

# ---------------------------------------------------------------------------
# Persistence and defence evasion.
# ---------------------------------------------------------------------------
rule Persistence_Registry_Runkeys : persistence {
    meta:
        severity    = medium
        description = "References autostart registry locations"
    strings:
        $a = "Software\\Microsoft\\Windows\\CurrentVersion\\Run" nocase ascii wide
        $b = "Software\\Microsoft\\Windows\\CurrentVersion\\RunOnce" nocase ascii wide
        $c = "Microsoft\\Windows NT\\CurrentVersion\\Winlogon" nocase ascii wide
        $d = "Image File Execution Options" nocase ascii wide
        $e = "AppInit_DLLs" nocase ascii wide
    condition:
        any of them
}

rule Evasion_Defender_Tamper : evasion {
    meta:
        severity    = critical
        description = "Attempts to disable Microsoft Defender or event logging"
    strings:
        $a = "Set-MpPreference -DisableRealtimeMonitoring" nocase ascii wide
        $b = "Add-MpPreference -ExclusionPath" nocase ascii wide
        $c = "DisableAntiSpyware" nocase ascii wide
        $d = "wevtutil cl" nocase ascii wide
        $e = "Clear-EventLog" nocase ascii wide
        $f = "netsh advfirewall set allprofiles state off" nocase ascii wide
    condition:
        any of them
}

rule Evasion_Sandbox_Checks : evasion antianalysis {
    meta:
        severity    = medium
        description = "Enumerates analysis-environment artifacts before running"
    strings:
        $a = "VBoxService" nocase ascii wide
        $b = "vmtoolsd" nocase ascii wide
        $c = "SbieDll.dll" nocase ascii wide
        $d = "wireshark" nocase ascii wide
        $e = "procmon" nocase ascii wide
        $f = "x64dbg" nocase ascii wide
        $g = "VIRTUAL HD" nocase ascii wide
    condition:
        3 of them
}

# ---------------------------------------------------------------------------
# Shellcode stubs. Small, high-value, low false-positive patterns.
# ---------------------------------------------------------------------------
rule Shellcode_PEB_Walk_x64 : shellcode {
    meta:
        severity    = high
        description = "x64 PEB walk (GS:[0x60] -> Ldr) used by position-independent loaders"
    strings:
        $peb64 = { 65 48 8B 04 25 60 00 00 00 }
        $ldr   = { 48 8B ?? 18 48 8B ?? 20 }
    condition:
        all of them and filesize < 8MB
}

rule Shellcode_PEB_Walk_x86 : shellcode {
    meta:
        severity    = high
        description = "x86 PEB access via fs:[0x30] in an unambiguous encoding"
    strings:
        # mov eax, fs:[0x30] -- the moffs form emitted by every common assembler.
        $moffs = { 64 A1 30 00 00 00 }
        # mov r32, fs:[0x30] -- disp32 form. The trailing 30 00 00 00 makes each of
        # these seven bytes long, which is specific enough to stand on its own.
        $d32_eax = { 64 8B 05 30 00 00 00 }
        $d32_ecx = { 64 8B 0D 30 00 00 00 }
        $d32_edx = { 64 8B 15 30 00 00 00 }
        $d32_ebx = { 64 8B 1D 30 00 00 00 }
        $d32_esp = { 64 8B 25 30 00 00 00 }
        $d32_ebp = { 64 8B 2D 30 00 00 00 }
        $d32_esi = { 64 8B 35 30 00 00 00 }
        $d32_edi = { 64 8B 3D 30 00 00 00 }
    condition:
        any of them and filesize < 4MB
}

rule Shellcode_PEB_Walk_x86_Indexed : shellcode {
    meta:
        severity    = high
        description = "x86 PEB walk through a zeroed base register, matched as one contiguous instruction sequence"
    strings:
        # Zero a register, then read fs:[reg+0x30]. Encoding the two instructions
        # as a single pattern is what makes this safe: `64 8B 40 30` on its own is
        # `mov eax, fs:[rax+0x30]`, an ordinary thread-local-storage access that
        # appears throughout glibc, libgomp and Go runtimes. Only the tight
        # zero-then-load pair is characteristic of a position-independent loader.
        # Both XOR encodings (31 /r and 33 /r) are covered.
        $z31_eax = { 31 C0 64 8B 40 30 }
        $z31_ecx = { 31 C9 64 8B 49 30 }
        $z31_edx = { 31 D2 64 8B 52 30 }
        $z31_ebx = { 31 DB 64 8B 5B 30 }
        $z31_ebp = { 31 ED 64 8B 6D 30 }
        $z31_esi = { 31 F6 64 8B 76 30 }
        $z31_edi = { 31 FF 64 8B 7F 30 }
        $z33_eax = { 33 C0 64 8B 40 30 }
        $z33_ecx = { 33 C9 64 8B 49 30 }
        $z33_edx = { 33 D2 64 8B 52 30 }
        $z33_ebx = { 33 DB 64 8B 5B 30 }
        $z33_ebp = { 33 ED 64 8B 6D 30 }
        $z33_esi = { 33 F6 64 8B 76 30 }
        $z33_edi = { 33 FF 64 8B 7F 30 }
        # The same access followed immediately by a PEB_LDR_DATA field read,
        # with the loader's usual "keep everything in one register" idiom:
        #     mov edx, fs:[edx+0x30]   ; PEB
        #     mov edx, [edx+0x0C]      ; PEB->Ldr
        # Seven fully specified bytes, and every ModRM value is enumerated rather
        # than wildcarded. A wildcard would also admit mod=01/rm=100, where the
        # next byte is a SIB byte and 0x30 is not a displacement at all -- the
        # exact imprecision that made an earlier version of this rule fire on
        # ordinary thread-local-storage code.
        $p0C_eax = { 64 8B 40 30 8B 40 0C }   # PEB->Ldr via eax
        $p0C_ecx = { 64 8B 49 30 8B 49 0C }   # PEB->Ldr via ecx
        $p0C_edx = { 64 8B 52 30 8B 52 0C }   # PEB->Ldr via edx
        $p0C_ebx = { 64 8B 5B 30 8B 5B 0C }   # PEB->Ldr via ebx
        $p0C_ebp = { 64 8B 6D 30 8B 6D 0C }   # PEB->Ldr via ebp
        $p0C_esi = { 64 8B 76 30 8B 76 0C }   # PEB->Ldr via esi
        $p0C_edi = { 64 8B 7F 30 8B 7F 0C }   # PEB->Ldr via edi
        $p14_eax = { 64 8B 40 30 8B 40 14 }   # InLoadOrder via eax
        $p14_ecx = { 64 8B 49 30 8B 49 14 }   # InLoadOrder via ecx
        $p14_edx = { 64 8B 52 30 8B 52 14 }   # InLoadOrder via edx
        $p14_ebx = { 64 8B 5B 30 8B 5B 14 }   # InLoadOrder via ebx
        $p14_ebp = { 64 8B 6D 30 8B 6D 14 }   # InLoadOrder via ebp
        $p14_esi = { 64 8B 76 30 8B 76 14 }   # InLoadOrder via esi
        $p14_edi = { 64 8B 7F 30 8B 7F 14 }   # InLoadOrder via edi
        $p1C_eax = { 64 8B 40 30 8B 40 1C }   # InInitOrder via eax
        $p1C_ecx = { 64 8B 49 30 8B 49 1C }   # InInitOrder via ecx
        $p1C_edx = { 64 8B 52 30 8B 52 1C }   # InInitOrder via edx
        $p1C_ebx = { 64 8B 5B 30 8B 5B 1C }   # InInitOrder via ebx
        $p1C_ebp = { 64 8B 6D 30 8B 6D 1C }   # InInitOrder via ebp
        $p1C_esi = { 64 8B 76 30 8B 76 1C }   # InInitOrder via esi
        $p1C_edi = { 64 8B 7F 30 8B 7F 1C }   # InInitOrder via edi
    condition:
        any of them and filesize < 16MB
}
